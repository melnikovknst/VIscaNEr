# demo: catalog and example work, real uploads explicitly return 503 until connected.
# local: load the trained DINOv3 checkpoint + its matching gallery.
# remote: send a normalized image to colleagues' HTTP endpoint.
VISCANER_MODEL_PROVIDER=demo
VISCANER_CHECKPOINT_PATH=models/dinov3_retrieval/best.pt
VISCANER_GALLERY_PATH=runs/dinov3_retrieval/gallery_embeddings.pt
# Optional YOLO detector. Without it, photograph/crop just the label.
# VISCANER_DETECTOR_PATH=models/yolo/best.pt
VISCANER_DEVICE=auto
VISCANER_REMOTE_URL=http://127.0.0.1:9000/predict
VISCANER_REMOTE_API_KEY=
VISCANER_TIMEOUT_SECONDS=30
# Provisional cosine thresholds: calibrate on public field photos.
VISCANER_MIN_SIMILARITY=0.65
VISCANER_MIN_MARGIN=0.04
VISCANER_MAX_UPLOAD_MB=12
