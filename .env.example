# winescanner settings. run.sh copies this file to .env on the first start;
# edit .env and run ./run.sh again to apply.

# Port on this machine: web interface and API.
PORT=8080

# auto | cuda | cpu
VISCANER_DEVICE=auto

# When the scanner answers. Confidence is the softmax over the Transformer's
# top-10 logits. Below MIN_CONFIDENCE /v1/eval/predict returns {"slug": null}
# (an honest "not in the catalog"); the web interface then offers a choice down
# to MIN_SUGGEST_CONFIDENCE. Higher = more honest nulls, fewer right answers.
VISCANER_MIN_CONFIDENCE=0.45
VISCANER_MIN_SUGGEST_CONFIDENCE=0.20

# Sommelier: wine picks and pairing explained by an LLM, grounded in the catalog.
# Off by default: the "К столу" page then uses editorial rules. To turn it on,
# put an OpenRouter key below and set ENABLED=true (downloads bge-m3, ~2.3 GB, once).
VISCANER_SOMMELIER_ENABLED=false
VISCANER_SOMMELIER_BACKEND=openrouter
VISCANER_OPENROUTER_API_KEY=
VISCANER_OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
