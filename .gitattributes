# Store dataset contents in Git LFS regardless of file extension.
/data/** filter=lfs diff=lfs merge=lfs -text
/datasets/** filter=lfs diff=lfs merge=lfs -text

# Store common dataset archives and binary formats in Git LFS anywhere.
*.7z filter=lfs diff=lfs merge=lfs -text
*.bz2 filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.rar filter=lfs diff=lfs merge=lfs -text
*.tar filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.xz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.hdf5 filter=lfs diff=lfs merge=lfs -text
*.npy filter=lfs diff=lfs merge=lfs -text
*.npz filter=lfs diff=lfs merge=lfs -text
*.parquet filter=lfs diff=lfs merge=lfs -text
*.feather filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text

# Keep this dataset's small annotations readable on GitHub.
/datasets/store_shelves_v1/*.csv -filter diff merge text eol=lf
/datasets/store_shelves_v1/*.json -filter diff merge text eol=lf
/datasets/store_shelves_v1/*.md -filter diff merge text eol=lf
/datasets/store_shelves_v2/*.csv -filter diff merge text eol=lf
/datasets/store_shelves_v2/*.json -filter diff merge text eol=lf
/datasets/store_shelves_v2/*.md -filter diff merge text eol=lf
/datasets/store_shelves_catalog/*.csv -filter diff merge text eol=lf
/datasets/store_shelves_catalog/*.md -filter diff merge text eol=lf
/datasets/store_shelves_web/*.csv -filter diff merge text eol=lf
/datasets/store_shelves_web/*.md -filter diff merge text eol=lf
/datasets/inference_galleries.sha256.json -filter diff merge text eol=lf
