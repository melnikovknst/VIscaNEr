# demo:    catalog and example work, real uploads explicitly return 503.
# local:   the colleagues' final pipeline (README, infer_wine.py): YOLO bottle
#          detector -> DINOv3-B/16 bottle model -> gallery cache. Recommended.
# cascade: earlier experiment - label-crop DINO + whole-bottle resolver.
# remote:  send a normalized image to colleagues' HTTP endpoint.
VISCANER_MODEL_PROVIDER=local
VISCANER_DEVICE=auto

# --- cascade -----------------------------------------------------------------
# Detectors: the colleagues' originals (models/weights_sha256.json).
VISCANER_LABEL_DETECTOR_PATH=models/yolo_label_detector/best.pt
VISCANER_BOTTLE_DETECTOR_PATH=models/bottle_reranker/best_bottle_detector.pt
# Whole-bottle resolver: DINOv3-B/16, built from the pinned backbone via
# deeptune_backbones and loaded strictly from the fine-tuned checkpoint.
VISCANER_RESOLVER_VARIANT=vitb16
VISCANER_RESOLVER_CHECKPOINT=models/trained_checkpoints/dinov3_vitb16_bottles_best_full.pt
VISCANER_RESOLVER_BACKBONE_PATH=models/dinov3/model.safetensors

# Stage-1 gap at or below which the bottle model re-orders the top two.
# 0 = off. On real photos its effect is within noise (+1 photo on selection,
# -1 on the held-out half), so it is kept to near-exact ties only.
VISCANER_AMBIGUITY_MARGIN=0.005
VISCANER_MIN_RESOLVER_MARGIN=0.01

# --- local (the colleagues' final pipeline) -----------------------------------
VISCANER_CHECKPOINT_PATH=models/trained_checkpoints/dinov3_vitb16_bottles_best_full.pt
# Built by the first run of infer_wine.py from datasets/bottle_classifier_crops/refs.
VISCANER_GALLERY_PATH=runs/inference/dinov3_vitb16_bottles_gallery.pt
VISCANER_DETECTOR_PATH=models/bottle_reranker/best_bottle_detector.pt

# When to answer instead of offering a choice. Chosen for the local pipeline on
# the selection half of the relabeled real_photos_v4 by scripts/evaluate_relabeled.py
# (evaluation/relabeled_scores.json) and scored once on the held-out half.
# Cosine similarities are not probabilities; recalibrate after any model change.
# The margin is small because duplicate catalog cards of one wine tie at the top.
VISCANER_MIN_SIMILARITY=0.59
VISCANER_MIN_MARGIN=0.004
# Between this and MIN_SIMILARITY the site asks "which of these is yours?"
# instead of "not recognised": on the selection half the right wine is among
# the five candidates in 50-60% of such photos, below 0.50 in about 15%.
VISCANER_MIN_SUGGEST_SIMILARITY=0.50

# --- remote --------------------------------------------------------------------
VISCANER_REMOTE_URL=http://127.0.0.1:9000/predict
VISCANER_REMOTE_API_KEY=
VISCANER_TIMEOUT_SECONDS=30

VISCANER_MAX_UPLOAD_MB=12
